# Copy these into Netlify: Project configuration, Environment variables. Never put real values in GitHub.

# Supabase: Project settings, API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-the-service_role-key-here

# Paystack: Settings, API Keys. Use the test key first (starts sk_test_)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
# Paystack: Products, Plans. The plan code looks like PLN_xxxxxxxx
PAYSTACK_PLAN_CODE=PLN_xxxxxxxx
# Plan price in cents (R149.00 is 14900)
PLAN_AMOUNT_CENTS=14900

# Your live address, no trailing slash
SITE_URL=https://yourdomain.co.za

# Set to true once payments are tested, so saving needs an active subscription
REQUIRE_SUBSCRIPTION=false
